<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>PowerPete.IvrToolkit.Plugins</AssemblyName>
    <RootNamespace>PowerPete.IvrToolkit</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\PowerPete.IvrToolkit.snk</AssemblyOriginatorKeyFile>
    <Version>1.0.0</Version>
    <Company>Power Pete</Company>
    <Product>Contact Center IVR Toolkit</Product>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all" />
  </ItemGroup>


  <!--
    Plugin assemblies are a single file. Newtonsoft is merged in rather than
    referenced, because the sandbox loads one assembly and nothing else.
  -->
  <Target Name="MergeDependencies" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <ItemGroup>
      <MergeAssemblies Include="$(OutputPath)Newtonsoft.Json.dll" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      InputAssemblies="$(OutputPath)$(AssemblyName).dll;@(MergeAssemblies)"
      OutputFile="$(OutputPath)merged\$(AssemblyName).dll"
      KeyFile="$(AssemblyOriginatorKeyFile)"
      Internalize="true"
      TargetKind="Dll" />
  </Target>

</Project>
