          "200": {
            "description": "Get broadcast message",
            "schema": {
              "$ref": "#/definitions/GetBroadcastMessageResponse"
            }
          }
        }
      }
    },
    "/pwrp_LogIvrOutcome": {
      "post": {
        "summary": "Log IVR outcome",
        "description": "Records what the agent did so containment and deflection can be reported. Call once at the end of every conversation.",
        "operationId": "LogIvrOutcome",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LogIvrOutcomeRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Log IVR outcome",
            "schema": {
              "$ref": "#/definitions/LogIvrOutcomeResponse"
            }
          }
        }
      }
    },
    "/pwrp_HealthCheck()": {
      "get": {
        "summary": "Health check",
        "description": "Validates the installation. Run after install and after every platform update.",
        "operationId": "HealthCheck",
        "parameters": [],
