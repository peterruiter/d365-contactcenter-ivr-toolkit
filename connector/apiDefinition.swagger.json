          }
        ],
        "responses": {
          "200": {
            "description": "Reschedule callback",
            "schema": {
              "$ref": "#/definitions/RescheduleCallbackResponse"
            }
          }
        }
      }
    },
    "/pwrp_ValidatePhoneNumber(PhoneNumber=@{encodeURIComponent(parameters('PhoneNumber'))},CountryCode=@{encodeURIComponent(parameters('CountryCode'))})": {
      "get": {
        "summary": "Validate phone number",
        "description": "Normalises a spoken or typed phone number to E.164 and returns a digit by digit spelling for confirmation.",
        "operationId": "ValidatePhoneNumber",
        "parameters": [
          {
            "name": "PhoneNumber",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "PhoneNumber"
          },
          {
            "name": "CountryCode",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "CountryCode",
            "description": "Defaults to pwrp_DefaultCountryCode."
          }
        ],
        "responses": {
          "200": {
            "description": "Validate phone number",
            "schema": {
              "$ref": "#/definitions/ValidatePhoneNumberResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetBroadcastMessage(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Get broadcast message",
        "description": "Returns an active outage or announcement message for a queue, if an administrator has published one.",
        "operationId": "GetBroadcastMessage",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
