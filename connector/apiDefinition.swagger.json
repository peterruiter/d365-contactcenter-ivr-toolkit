{
  "swagger": "2.0",
  "info": {
    "title": "Contact Center IVR Toolkit",
    "description": "Queue state, opening hours, live wait times and callbacks for Dynamics 365 Contact Center, shaped for voice agents. Every operation accepts a queue name or id and returns a speakable string alongside structured data. Start with GetQueueContext: it answers open or closed, how busy, is there an outage and what to do next, in one call.",
    "version": "1.0",
    "contact": {
      "name": "Power Pete"
    }
  },
  "host": "{organisation}.api.crm4.dynamics.com",
  "basePath": "/api/data/v9.2",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/pwrp_GetQueues(ChannelType=@{encodeURIComponent(parameters('ChannelType'))})": {
      "get": {
        "summary": "Get queues",
        "description": "Lists active contact centre queues the agent can route to, optionally filtered by channel.",
        "operationId": "GetQueues",
        "parameters": [
          {
            "name": "ChannelType",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "ChannelType",
            "description": "Voice, Messaging or Record. Leave empty for all."
          }
        ],
        "responses": {
          "200": {
            "description": "Get queues",
            "schema": {
              "$ref": "#/definitions/GetQueuesResponse"
            }
          }
        }
      }
    },
    "/pwrp_ResolveQueue(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Resolve queue",
        "description": "Turns a spoken or typed queue name into a queue id using aliases and fuzzy matching. Call once, then reuse the id.",
        "operationId": "ResolveQueue",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue",
            "description": "Queue name, alias or id."
          }
        ],
        "responses": {
          "200": {
            "description": "Resolve queue",
            "schema": {
              "$ref": "#/definitions/ResolveQueueResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetQueueContext(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Get queue context",
        "description": "Returns opening state, live wait band, outage message, callback availability and a recommended action in one call. Use this at the start of a voice conversation instead of several separate lookups.",
        "operationId": "GetQueueContext",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue",
            "description": "Queue name, alias or id."
          }
        ],
        "responses": {
          "200": {
            "description": "Get queue context",
            "schema": {
              "$ref": "#/definitions/GetQueueContextResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetQueueHours(Queue=@{encodeURIComponent(parameters('Queue'))},FromDate=@{encodeURIComponent(parameters('FromDate'))},Days=@{encodeURIComponent(parameters('Days'))})": {
      "get": {
        "summary": "Get queue hours",
        "description": "Opening hours for a queue across a date range, holiday exceptions included.",
        "operationId": "GetQueueHours",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          },
          {
            "name": "FromDate",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "FromDate",
            "description": "Defaults to today."
          },
          {
            "name": "Days",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "Days",
            "description": "1 to 31. Defaults to 1."
          }
        ],
        "responses": {
          "200": {
            "description": "Get queue hours",
            "schema": {
              "$ref": "#/definitions/GetQueueHoursResponse"
            }
          }
        }
      }
    },
    "/pwrp_IsQueueOpen(Queue=@{encodeURIComponent(parameters('Queue'))},AtUtc=@{encodeURIComponent(parameters('AtUtc'))})": {
      "get": {
        "summary": "Is queue open",
        "description": "Whether a queue is open now, or at a future moment. Use the future form to check a proposed callback time.",
        "operationId": "IsQueueOpen",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          },
          {
            "name": "AtUtc",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "AtUtc",
            "description": "Defaults to now."
          }
        ],
        "responses": {
          "200": {
            "description": "Is queue open",
            "schema": {
              "$ref": "#/definitions/IsQueueOpenResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetNextOpenTime(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Get next open time",
        "description": "When the queue opens next, with a phrase the agent can read out.",
        "operationId": "GetNextOpenTime",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          }
        ],
        "responses": {
          "200": {
            "description": "Get next open time",
            "schema": {
              "$ref": "#/definitions/GetNextOpenTimeResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetQueueMetrics(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Get queue metrics",
        "description": "Live queue state: callers waiting, longest wait, average wait, representatives available and an estimated wait. Give callers WaitBand, not the raw numbers.",
        "operationId": "GetQueueMetrics",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          }
        ],
        "responses": {
          "200": {
            "description": "Get queue metrics",
            "schema": {
              "$ref": "#/definitions/GetQueueMetricsResponse"
            }
          }
        }
      }
    },
    "/pwrp_CheckCallbackEligibility(Queue=@{encodeURIComponent(parameters('Queue'))})": {
      "get": {
        "summary": "Check callback eligibility",
        "description": "Whether direct callback, scheduled callback or neither is available for a queue. Call before offering a callback.",
        "operationId": "CheckCallbackEligibility",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          }
        ],
        "responses": {
          "200": {
            "description": "Check callback eligibility",
            "schema": {
              "$ref": "#/definitions/CheckCallbackEligibilityResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetCallbackSlots(Queue=@{encodeURIComponent(parameters('Queue'))},Days=@{encodeURIComponent(parameters('Days'))},MaxResults=@{encodeURIComponent(parameters('MaxResults'))})": {
      "get": {
        "summary": "Get callback slots",
        "description": "Bookable callback windows inside opening hours, with remaining capacity. Offer at most three over the phone.",
        "operationId": "GetCallbackSlots",
        "parameters": [
          {
            "name": "Queue",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Queue"
          },
          {
            "name": "Days",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "Days",
            "description": "1 to 14. Defaults to 3."
          },
          {
            "name": "MaxResults",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "MaxResults",
            "description": "Defaults to 6."
          }
        ],
        "responses": {
          "200": {
            "description": "Get callback slots",
            "schema": {
              "$ref": "#/definitions/GetCallbackSlotsResponse"
            }
          }
        }
      }
    },
    "/pwrp_CreateCallback": {
      "post": {
        "summary": "Create callback",
        "description": "Books a callback. Mode Direct queues it for the next free representative. Mode Scheduled books a specific slot. Repeated calls for the same number and queue return the existing request rather than creating a duplicate.",
        "operationId": "CreateCallback",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCallbackRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Create callback",
            "schema": {
              "$ref": "#/definitions/CreateCallbackResponse"
            }
          }
        }
      }
    },
    "/pwrp_GetCallbackStatus(Reference=@{encodeURIComponent(parameters('Reference'))},PhoneNumber=@{encodeURIComponent(parameters('PhoneNumber'))},CallbackId=@{encodeURIComponent(parameters('CallbackId'))})": {
      "get": {
        "summary": "Get callback status",
        "description": "Looks up a callback by reference, phone number or id.",
        "operationId": "GetCallbackStatus",
        "parameters": [
          {
            "name": "Reference",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Reference"
          },
          {
            "name": "PhoneNumber",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "PhoneNumber"
          },
          {
            "name": "CallbackId",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "CallbackId"
          }
        ],
        "responses": {
          "200": {
            "description": "Get callback status",
            "schema": {
              "$ref": "#/definitions/GetCallbackStatusResponse"
            }
          }
        }
      }
    },
    "/pwrp_CancelCallback": {
      "post": {
        "summary": "Cancel callback",
        "description": "Cancels an open callback request.",
        "operationId": "CancelCallback",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CancelCallbackRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancel callback",
            "schema": {
              "$ref": "#/definitions/CancelCallbackResponse"
            }
          }
        }
      }
    },
    "/pwrp_RescheduleCallback": {
      "post": {
        "summary": "Reschedule callback",
        "description": "Moves a scheduled callback to a different available slot.",
        "operationId": "RescheduleCallback",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RescheduleCallbackRequest"
